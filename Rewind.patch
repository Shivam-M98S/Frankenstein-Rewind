@@ -0,0 +1,48 @@
+import 'dart:convert';
+
+import 'package:classipod/features/rewind/spotify_setup.dart';
+import 'package:http/http.dart' as http;
+
+class SpotifyLibrary {
+  SpotifyLibrary(this._token, {http.Client? client})
+    : _client = client ?? http.Client();
+
+  final Future<String> Function(String id, {bool renew}) _token;
+  final http.Client _client;
+
+  Future<Map<String, dynamic>> page(
+    String clientId,
+    String collection, {
+    String? next,
+    int limit = 50,
+  }) async {
+    final path = switch (collection) {
+      'Playlists' => '/v1/me/playlists',
+      'Liked Songs' => '/v1/me/tracks',
+      'Spotify albums' => '/v1/me/albums',
+      _ => throw ArgumentError.value(collection),
+    };
+    final uri = next == null
+        ? Uri.https('api.spotify.com', path, {'limit': '$limit'})
+        : Uri.parse(next);
+    if (uri.origin != 'https://api.spotify.com' ||
+        uri.path != path ||
+        uri.userInfo.isNotEmpty) {
+      throw StateError('Unexpected Spotify library address.');
+    }
+    Future<http.Response> getPage({required bool renew}) async {
+      final token = await _token(clientId, renew: renew);
+      return _client
+          .get(uri, headers: {'Authorization': 'Bearer $token'})
+          .timeout(const Duration(seconds: 20));
+    }
+
+    var response = await getPage(renew: false);
+    if (response.statusCode == 401) response = await getPage(renew: true);
+    if (response.statusCode != 200)
+      throw StateError(spotifyLibraryHint(response.statusCode));
+    return jsonDecode(utf8.decode(response.bodyBytes)) as Map<String, dynamic>;
+  }
+
+  void close() => _client.close();
+}
diff --git a/lib/features/rewind/spotify_oauth.dart b/lib/features/rewind/spotify_oauth.dart
new file mode 100644
index 0000000..b96d3ba
--- /dev/null
+++ b/lib/features/rewind/spotify_oauth.dart
@@ -0,0 +1,132 @@
+import 'dart:convert';
+import 'dart:math';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_web_auth_2/flutter_web_auth_2.dart';
+import 'package:http/http.dart' as http;
+
+String pkceChallenge(String verifier) => base64Url
+    .encode(sha256.convert(ascii.encode(verifier)).bytes)
+    .replaceAll('=', '');
+
+class SpotifyOAuth {
+  SpotifyOAuth({http.Client? client}) : client = client ?? http.Client();
+  final http.Client client;
+  final storage = const FlutterSecureStorage();
+  Future<String>? pending;
+  String? pendingId;
+
+  Future<String> token(
+    String id,
+    String redirect, {
+    bool renew = false,
+    bool interactive = true,
+  }) async {
+    if (pending != null && pendingId == id) return pending!;
+    pendingId = id;
+    final request = _token(id, Uri.parse(redirect), renew, interactive);
+    pending = request;
+    try {
+      return await request;
+    } finally {
+      if (identical(pending, request)) pending = null;
+    }
+  }
+
+  Future<String> _token(
+    String id,
+    Uri redirect,
+    bool renew,
+    bool interactive,
+  ) async {
+    final key = 'rewind.pkce.$id';
+    final saved = jsonDecode(await storage.read(key: key) ?? '{}') as Map;
+    final now = DateTime.now().millisecondsSinceEpoch;
+    if (!renew &&
+        (saved['expires'] as int? ?? 0) > now + 60000 &&
+        saved['access'] is String) {
+      return saved['access'] as String;
+    }
+    Future<http.Response> exchange(Map<String, String> body) => client
+        .post(
+          Uri.https('accounts.spotify.com', '/api/token'),
+          body: {'client_id': id, ...body},
+        )
+        .timeout(const Duration(seconds: 20));
+    final refresh = saved['refresh'] as String?;
+    http.Response? result;
+    if (refresh != null) {
+      result = await exchange({
+        'grant_type': 'refresh_token',
+        'refresh_token': refresh,
+      });
+      if (result.statusCode == 400 &&
+          jsonDecode(result.body)['error'] == 'invalid_grant')
+        result = null;
+    }
+    if (result == null) {
+      if (!interactive)
+        throw StateError('Reconnect Spotify to renew authorization.');
+      String nonce() {
+        final rng = Random.secure();
+        return base64Url
+            .encode(List.generate(48, (_) => rng.nextInt(256)))
+            .replaceAll('=', '');
+      }
+
+      final verifier = nonce(), state = nonce();
+      final url = Uri.https('accounts.spotify.com', '/authorize', {
+        'client_id': id,
+        'response_type': 'code',
+        'redirect_uri': redirect.toString(),
+        'code_challenge_method': 'S256',
+        'code_challenge': pkceChallenge(verifier),
+        'state': state,
+        'scope': 'user-library-read playlist-read-private playlist-read-collaborative user-read-playback-state user-modify-playback-state',
+      });
+      final reply = Uri.parse(
+        await FlutterWebAuth2.authenticate(
+          url: url.toString(),
+          callbackUrlScheme: redirect.scheme,
+        ),
+      );
+      if (reply.scheme != redirect.scheme ||
+          reply.authority != redirect.authority ||
+          reply.path != redirect.path ||
+          reply.queryParameters['state'] != state) {
+        throw StateError('Spotify sign-in callback did not match. Try again.');
+      }
+      final code = reply.queryParameters['code'];
+      if (code == null)
+        throw StateError(
+          'Spotify sign-in was declined. Choose Connect to retry.',
+        );
+      result = await exchange({
+        'grant_type': 'authorization_code',
+        'redirect_uri': redirect.toString(),
+        'code_verifier': verifier,
+        'code': code,
+      });
+    }
+    if (result.statusCode != 200)
+      throw StateError(
+        'Spotify sign-in returned HTTP ${result.statusCode}. Retry when online.',
+      );
+    final data = jsonDecode(result.body) as Map;
+    final access = data['access_token'] as String;
+    await storage.write(
+      key: key,
+      value: jsonEncode({
+        'access': access,
+        'refresh': data['refresh_token'] ?? refresh,
+        'expires':
+            DateTime.now().millisecondsSinceEpoch +
+            ((data['expires_in'] as int) * 1000),
+      }),
+    );
+    return access;
+  }
+
+  Future<void> forget(String id) => storage.delete(key: 'rewind.pkce.$id');
+}
diff --git a/lib/features/rewind/spotify_session.dart b/lib/features/rewind/spotify_session.dart
new file mode 100644
index 0000000..a6efe4b
--- /dev/null
+++ b/lib/features/rewind/spotify_session.dart
@@ -0,0 +1,287 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+import 'package:http/http.dart' as http;
+
+import 'spotify_oauth.dart';
+
+import 'package:classipod/features/rewind/spotify_setup.dart';
+
+import 'dart:typed_data';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:spotify_sdk/spotify_sdk.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+
+final spotify = SpotifySession();
+
+class SpotifySession extends ChangeNotifier {
+  static const redirect = 'frankensteinrewind://auth';
+  String get clientId => resolveSpotifyClientId(
+    rewindPrefs.getString('rewind.client'),
+    const String.fromEnvironment('SPOTIFY_CLIENT_ID'),
+  );
+
+  final storage = const FlutterSecureStorage();
+  int position = 0, duration = 0;
+  DateTime sampled = DateTime.now();
+  double get progress => duration <= 0
+      ? 0
+      : ((position +
+                    (paused
+                        ? 0
+                        : DateTime.now().difference(sampled).inMilliseconds)) /
+                duration)
+            .clamp(0.0, 1.0);
+  String album = '';
+  String track = '', artist = '', uri = '';
+  bool paused = true, active = false, connected = false;
+  Future<Uint8List?>? art;
+  StreamSubscription<dynamic>? subscription;
+  Future<void>? pending;
+
+  final oauth = SpotifyOAuth();
+  bool webPlayer = false;
+  Timer? poll;
+  bool polling = false;
+  Future<String> token(String id, {bool renew = false}) =>
+      oauth.token(id, redirect, renew: renew);
+
+  Future<http.Response> _api(
+    String method,
+    String path, {
+    Map<String, dynamic>? body,
+    Map<String, String>? query,
+    bool interactive = true,
+  }) async {
+    final uri = Uri.https('api.spotify.com', '/v1/me/player$path', query);
+    Future<http.Response> send(bool renew) async {
+      final headers = {
+        'Authorization':
+            'Bearer ${await oauth.token(clientId, redirect, renew: renew, interactive: interactive)}',
+        'Content-Type': 'application/json',
+      };
+      final payload = body == null ? null : jsonEncode(body);
+      return switch (method) {
+        'GET' => http.get(uri, headers: headers),
+        'POST' => http.post(uri, headers: headers, body: payload),
+        _ => http.put(uri, headers: headers, body: payload),
+      };
+    }
+
+    var res = await send(false).timeout(const Duration(seconds: 18));
+    if (res.statusCode == 401)
+      res = await send(true).timeout(const Duration(seconds: 18));
+    if (res.statusCode == 404)
+      throw StateError(
+        'Start a song in Spotify on this phone or another Spotify Connect device, then retry.',
+      );
+    if (res.statusCode == 403)
+      throw StateError(
+        'Spotify denied playback. Check Premium, tester access and the selected device.',
+      );
+    if (res.statusCode >= 300)
+      throw StateError('Spotify playback returned HTTP ${res.statusCode}.');
+    return res;
+  }
+
+  Future<void> syncWeb({bool interactive = true}) async {
+    if (polling || !webPlayer) return;
+    polling = true;
+    try {
+      final res = await _api('GET', '', interactive: interactive);
+      if (!webPlayer) return;
+      final state = res.statusCode == 204 ? null : jsonDecode(res.body) as Map?;
+      final item = state?['item'] as Map?;
+      final current = item?['uri'] as String? ?? '';
+      if (current != uri) {
+        final images = item?['album']?['images'] as List?;
+        final url = images == null || images.isEmpty
+            ? null
+            : Uri.tryParse(images.first['url'] as String? ?? '');
+        art = url == null || url.scheme != 'https'
+            ? null
+            : http
+                  .get(url)
+                  .then<Uint8List?>(
+                    (r) => r.statusCode == 200 ? r.bodyBytes : null,
+                  )
+                  .catchError((_) => null);
+      }
+      uri = current;
+      track = item?['name'] as String? ?? '';
+      artist = (item?['artists'] as List? ?? [])
+          .map((a) => a['name'])
+          .join(', ');
+      album = item?['album']?['name'] as String? ?? '';
+      position = state?['progress_ms'] as int? ?? 0;
+      duration = item?['duration_ms'] as int? ?? 0;
+      paused = state?['is_playing'] != true;
+      sampled = DateTime.now();
+      if (!paused && uri.isNotEmpty) active = true;
+      if (uri.isEmpty) active = false;
+      notifyListeners();
+    } finally {
+      polling = false;
+    }
+  }
+
+  Future<void> play({required String spotifyUri}) async {
+    if (!webPlayer) {
+      await SpotifySdk.play(spotifyUri: spotifyUri);
+      return;
+    }
+    await _api(
+      'PUT',
+      '/play',
+      body: spotifyUri.startsWith('spotify:track:')
+          ? {
+              'uris': [spotifyUri],
+            }
+          : {'context_uri': spotifyUri},
+    );
+    await syncWeb();
+  }
+
+  Future<void> pause() async {
+    if (webPlayer) {
+      await _api('PUT', '/pause');
+      await syncWeb();
+    } else {
+      await SpotifySdk.pause();
+    }
+  }
+
+  Future<void> resume() async {
+    if (webPlayer) {
+      await _api('PUT', '/play');
+      await syncWeb();
+    } else {
+      await SpotifySdk.resume();
+    }
+  }
+
+  Future<void> skipNext() async {
+    if (webPlayer) {
+      await _api('POST', '/next');
+      await syncWeb();
+    } else {
+      await SpotifySdk.skipNext();
+    }
+  }
+
+  Future<void> skipPrevious() async {
+    if (webPlayer) {
+      await _api('POST', '/previous');
+      await syncWeb();
+    } else {
+      await SpotifySdk.skipPrevious();
+    }
+  }
+
+  Future<void> queue({required String spotifyUri}) async {
+    if (webPlayer) {
+      await _api('POST', '/queue', query: {'uri': spotifyUri});
+    } else {
+      await SpotifySdk.queue(spotifyUri: spotifyUri);
+    }
+  }
+
+  Future<void> connect(String id) async {
+    if (connected && webPlayer) return;
+    if (connected) {
+      try {
+        if (await SpotifySdk.getPlayerState() != null) return;
+      } catch (_) {}
+      connected = false;
+    }
+    await (pending ??= _open(id).whenComplete(() => pending = null));
+  }
+
+  Future<void> _open(String id) async {
+    await subscription?.cancel();
+    try {
+      connected = await SpotifySdk.connectToSpotifyRemote(
+        clientId: id,
+        redirectUrl: redirect,
+      );
+    } on PlatformException {
+      connected = false;
+    }
+    if (!connected) {
+      await token(id);
+      webPlayer = true;
+      try {
+        await syncWeb();
+      } catch (_) {
+        webPlayer = false;
+        rethrow;
+      }
+      connected = true;
+      poll?.cancel();
+      poll = Timer.periodic(const Duration(seconds: 8), (_) {
+        if (WidgetsBinding.instance.lifecycleState ==
+            AppLifecycleState.resumed) {
+          unawaited(syncWeb(interactive: false).catchError((Object _) {}));
+        }
+      });
+      return;
+    }
+    subscription = SpotifySdk.subscribePlayerState().listen(
+      (state) {
+        final song = state.track;
+        if (uri != (song?.uri ?? '')) {
+          final image = song?.imageUri;
+          art = image == null
+              ? null
+              : SpotifySdk.getImage(imageUri: image).catchError((_) => null);
+        }
+        uri = song?.uri ?? '';
+        track = song?.name ?? '';
+        artist = song?.artist.name ?? '';
+        album = song?.album.name ?? '';
+        position = state.playbackPosition;
+        duration = song?.duration ?? 0;
+        sampled = DateTime.now();
+        paused = state.isPaused;
+        if (!paused && uri.isNotEmpty) active = true;
+        notifyListeners();
+      },
+      onError: (Object _) {
+        connected = false;
+        notifyListeners();
+      },
+      onDone: () {
+        connected = false;
+        notifyListeners();
+      },
+    );
+  }
+
+  void selectLocal() {
+    if (active) {
+      active = false;
+      notifyListeners();
+    }
+  }
+
+  Future<void> reset(String old) async {
+    await subscription?.cancel();
+    poll?.cancel();
+    if (connected && !webPlayer) await SpotifySdk.disconnect();
+    webPlayer = false;
+    await oauth.forget(old);
+    await storage.delete(key: 'rewind.spotify.$old');
+    connected = false;
+    active = false;
+    track = '';
+    artist = '';
+    uri = '';
+    art = null;
+    await rewindPrefs.remove('rewind.client');
+    notifyListeners();
+  }
+}
diff --git a/lib/features/rewind/spotify_setup.dart b/lib/features/rewind/spotify_setup.dart
new file mode 100644
index 0000000..ed1af11
--- /dev/null
+++ b/lib/features/rewind/spotify_setup.dart
@@ -0,0 +1,40 @@
+String resolveSpotifyClientId(String? saved, String bundled) {
+  final override = saved?.trim() ?? '';
+  return override.isNotEmpty ? override : bundled.trim();
+}
+
+String spotifySetupHint(String code, String? detail) {
+  switch (code) {
+    case 'CouldNotFindSpotifyApp':
+      return 'Install Spotify, sign in, then try Connect playback.';
+    case 'NotLoggedInException':
+      return 'Open Spotify and sign in, then retry.';
+    case 'OfflineModeException':
+      return 'Take Spotify online, then retry.';
+    case 'UnsupportedFeatureVersionException':
+      return 'Update Spotify, then retry.';
+    case 'UserNotAuthorizedException':
+      return 'Open Spotify and approve access, then retry.';
+    case 'AuthenticationFailedException':
+      return 'Playback sign-in failed. Verify the client ID and the registration for this APK.';
+    case 'CANCELED':
+    case 'CANCELLED':
+      return 'Browser sign-in closed. Choose Connect to retry.';
+    case 'authenticationError':
+      if (detail?.toLowerCase().contains('cancel') ?? false) {
+        return 'Library sign-in closed. Choose Allow library access to retry.';
+      }
+      return 'Library sign-in failed. Check account access and this build\'s redirect URI.';
+    case 'SpotifyDisconnectedException':
+      return 'Spotify disconnected. Open Spotify and choose Connect playback.';
+    default:
+      return 'Spotify could not finish this action ($code). Open Spotify and retry.';
+  }
+}
+
+String spotifyLibraryHint(int status) => switch (status) {
+  401 => 'Library sign-in expired. Choose Allow library access and retry.',
+  403 => 'Library access denied (403). Check the Spotify test account and library permissions.',
+  429 => 'Spotify is receiving too many requests. Try again later.',
+  _ => 'Spotify library returned HTTP $status. Try again later.',
+};
