+    }
+    if (id.startsWith('smbfile:') || networkLibrary.validStream(id)) {
+      await networkPlay(entry);
+      return;
+    }
+    if (section == 'Liked Songs' && id.startsWith('spotify:track:')) {
+      await connect();
+      await ref.read(audioPlayerServiceProvider.notifier).pause();
+      await SpotifySdk.play(spotifyUri: id);
+      spotify.active = true;
+      final following = library.skip(library.indexOf(entry) + 1).toList();
+      page('Now Playing');
+      for (final next in following) {
