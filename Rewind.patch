+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+final rewindNight = ValueNotifier<bool>(false);
+final rewindPins = ValueNotifier<Map<String, String>>({});
+late SharedPreferences rewindPrefs;
+
+Future<void> loadRewindPreferences() async {
+  rewindPrefs = await SharedPreferences.getInstance();
+  rewindNight.value = rewindPrefs.getBool('rewind.night') ?? false;
+  final saved = rewindPrefs.getString('rewind.pins');
+  if (saved != null) {
+    rewindPins.value = Map<String, String>.from(jsonDecode(saved) as Map);
+  }
+}
+
+Future<void> savePin(String uri, String? name) async {
+  final next = {...rewindPins.value};
+  if (name == null) {
+    next.remove(uri);
+  } else {
+    next[uri] = name;
+  }
+  if (!await rewindPrefs.setString('rewind.pins', jsonEncode(next))) {
+    throw StateError('Could not save your shortcuts.');
+  }
+  rewindPins.value = next;
+}
+
+final rewindAppearance = ValueNotifier<int>(0);
