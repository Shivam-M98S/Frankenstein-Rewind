+                    color: i == selectedDisplayItem ? ink : paper,
+                    child: Text(
+                      rows[i].title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(
+                        color: i == selectedDisplayItem ? paper : ink,
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
