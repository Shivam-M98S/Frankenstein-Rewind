diff --git a/lib/features/rewind/cover_cache.dart b/lib/features/rewind/cover_cache.dart
new file mode 100644
index 0000000..2658197
--- /dev/null
+++ b/lib/features/rewind/cover_cache.dart
@@ -0,0 +1,90 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:http/http.dart' as http;
+import 'package:classipod/core/models/music_metadata.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+
+class CoverCache {
+  final String directory;
+  CoverCache(this.directory);
+  final results = <String, String?>{};
+  final folders = <String, String?>{};
+  Future<String?> find(MusicMetadata song) async {
+    if (song.filePath != null) {
+      final folder = File(song.filePath!).parent.path;
+      if (!folders.containsKey(folder)) {
+        folders[folder] = null;
+        for (final name in [
+          'cover.jpg',
+          'folder.jpg',
+          'Folder.jpg',
+          'cover.png',
+        ]) {
+          final file = File('$folder/$name');
+          if (await file.exists()) {
+            folders[folder] = file.path;
+            break;
+          }
+        }
+      }
+      if (folders[folder] != null) return folders[folder];
+    }
+    final artist = (song.albumArtistName ?? song.getTrackArtistNames ?? '')
+        .trim()
+        .toLowerCase();
+    final album = (song.albumName ?? '').trim().toLowerCase();
+    if (album.isEmpty || artist.isEmpty) return null;
+    final key = sha256.convert(utf8.encode('$artist\n$album')).toString();
+    if (results.containsKey(key)) return results[key];
+    results[key] = null;
+    final file = File('$directory/rewind-$key.jpg');
+    if (await file.exists()) return results[key] = file.path;
+    if (rewindPrefs.getBool('rewind.coverLookup') != true) return null;
+    final attempted = File('$directory/rewind-$key.miss');
+    if (await attempted.exists() &&
+        DateTime.now().difference(await attempted.lastModified()).inDays < 7)
+      return null;
+    try {
+      final search = await http
+          .get(
+            Uri.https('itunes.apple.com', '/search', {
+              'term': '$artist $album',
+              'entity': 'album',
+              'limit': '5',
+            }),
+          )
+          .timeout(const Duration(seconds: 5));
+      if (search.statusCode != 200) return null;
+      for (final row in jsonDecode(search.body)['results']) {
+        if (row['collectionName'].toString().trim().toLowerCase() != album ||
+            row['artistName'].toString().trim().toLowerCase() != artist)
+          continue;
+        final uri = Uri.tryParse(
+          row['artworkUrl100'].toString().replaceFirst(
+            '100x100bb',
+            '300x300bb',
+          ),
+        );
+        if (uri == null ||
+            uri.scheme != 'https' ||
+            !uri.host.endsWith('.mzstatic.com'))
+          continue;
+        final image = await http.get(uri).timeout(const Duration(seconds: 5));
+        if (image.statusCode != 200 ||
+            image.bodyBytes.isEmpty ||
+            image.bodyBytes.length > 2000000)
+          continue;
+        await file.parent.create(recursive: true);
+        final part = File('${file.path}.part');
+        await part.writeAsBytes(image.bodyBytes);
+        await part.rename(file.path);
+        return results[key] = file.path;
+      }
+      await attempted.parent.create(recursive: true);
+      await attempted.writeAsString('');
+    } catch (_) {}
+    return null;
+  }
+}
diff --git a/lib/features/rewind/network_library.dart b/lib/features/rewind/network_library.dart
new file mode 100644
index 0000000..dbf9ef7
--- /dev/null
+++ b/lib/features/rewind/network_library.dart
@@ -0,0 +1,188 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:http/http.dart' as http;
+import 'package:path_provider/path_provider.dart';
+import 'package:smb_connect/smb_connect.dart';
+import 'package:classipod/core/models/music_metadata.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+
+typedef Entry = ({String title, String id});
+final networkLibrary = NetworkLibrary();
+
+class NetworkLibrary {
+  final vault = const FlutterSecureStorage();
+  SmbConnect? share;
+  String root = '/';
+  final downloads = <String, Future<File>>{};
+  Future<void> configure(String address, String user, String password) async {
+    final uri = Uri.parse(address);
+    if (uri.scheme != 'smb' ||
+        uri.host.isEmpty ||
+        uri.pathSegments.where((s) => s.isNotEmpty).isEmpty ||
+        uri.userInfo.isNotEmpty) {
+      throw FormatException(
+        'Use smb://server/share or smb://server/share/folder.',
+      );
+    }
+    final next = await SmbConnect.connectAuth(
+      host: uri.host,
+      domain: '',
+      username: user,
+      password: password,
+    ).timeout(const Duration(seconds: 12));
+    try {
+      await next.listFiles(await next.file(uri.path));
+    } catch (_) {
+      await next.close();
+      rethrow;
+    }
+    await vault.write(
+      key: 'rewind.smb',
+      value: jsonEncode([address, user, password]),
+    );
+    await share?.close();
+    share = next;
+    root = uri.path;
+  }
+
+  Future<void> open() async {
+    if (share != null) return;
+    final saved = await vault.read(key: 'rewind.smb');
+    if (saved == null)
+      throw StateError('Add your shared folder in Settings  Library.');
+    final data = List<String>.from(jsonDecode(saved));
+    await configure(data[0], data[1], data[2]);
+  }
+
+  Future<List<Entry>> files(String path) async {
+    await open();
+    final folder = path.isEmpty ? root : path;
+    final rows = await share!.listFiles(await share!.file(folder));
+    final entries = <Entry>[
+      for (final f in rows)
+        if (f.name != '.' &&
+            f.name != '..' &&
+            (f.isDirectory() ||
+                RegExp(
+                  r'\.(mp3|flac|m4a|aac|ogg|opus|wav)$',
+                  caseSensitive: false,
+                ).hasMatch(f.name)))
+          (title: f.name, id: (f.isDirectory() ? 'dir:' : 'smbfile:') + f.path),
+    ];
+    entries.sort(
+      (a, b) => a.id.startsWith('dir:') == b.id.startsWith('dir:')
+          ? a.title.toLowerCase().compareTo(b.title.toLowerCase())
+          : a.id.startsWith('dir:')
+          ? -1
+          : 1,
+    );
+    return entries;
+  }
+
+  Future<File> cacheTrack(String path) async {
+    return downloads.putIfAbsent(
+      path,
+      () => _cache(path).whenComplete(() => downloads.remove(path)),
+    );
+  }
+
+  Future<File> _cache(String path) async {
+    await open();
+    final f = await share!.file(path);
+    final dir = Directory(
+      '${(await getTemporaryDirectory()).path}/rewind-share',
+    );
+    await dir.create(recursive: true);
+    final id = sha256.convert(
+      utf8.encode('${share!.host}/$path:${f.lastModified}:${f.size}'),
+    );
+    final file = File('${dir.path}/$id.${path.split('.').last}');
+    if (await file.exists() && await file.length() == f.size) return file;
+    final part = File('${file.path}.part');
+    try {
+      await (await share!.openRead(f)).pipe(part.openWrite());
+      if (await part.length() != f.size)
+        throw StateError(
+          'Incomplete network transfer. Retry on your home network.',
+        );
+      return await part.rename(file.path);
+    } finally {
+      if (await part.exists()) await part.delete();
+    }
+  }
+
+  List<Entry> get favorites {
+    final map =
+        jsonDecode(rewindPrefs.getString('rewind.stations') ?? '{}') as Map;
+    return [
+      for (final e in map.entries)
+        (title: e.value as String, id: e.key as String),
+    ];
+  }
+
+  Future<void> favorite(Entry e, bool add) async {
+    final map = {for (final f in favorites) f.id: f.title};
+    if (add) {
+      map[e.id] = e.title;
+    } else {
+      map.remove(e.id);
+    }
+    await rewindPrefs.setString('rewind.stations', jsonEncode(map));
+  }
+
+  Future<List<Entry>> stations({String? country, String? query}) async {
+    for (final host in [
+      'de1.api.radio-browser.info',
+      'at1.api.radio-browser.info',
+      'nl1.api.radio-browser.info',
+    ]) {
+      try {
+        final uri = Uri.https(host, '/json/stations/search', {
+          'hidebroken': 'true',
+          'limit': '80',
+          'order': 'votes',
+          'reverse': 'true',
+          if (country != null) 'countrycode': country,
+          if (query != null) 'name': query,
+        });
+        final response = await http
+            .get(uri, headers: {'User-Agent': 'FrankensteinRewind/0.2'})
+            .timeout(const Duration(seconds: 6));
+        if (response.statusCode != 200) continue;
+        final list = jsonDecode(utf8.decode(response.bodyBytes)) as List;
+        return [
+          for (final row in list)
+            if (validStream(row['url_resolved']))
+              (
+                title: row['name'].toString().trim(),
+                id: row['url_resolved'] as String,
+              ),
+        ];
+      } catch (_) {
+        continue;
+      }
+    }
+    throw StateError(
+      'Station directory unavailable. Favorites and custom stations are still available.',
+    );
+  }
+
+  bool validStream(dynamic url) {
+    final uri = url is String ? Uri.tryParse(url) : null;
+    return uri != null &&
+        ['https', 'http'].contains(uri.scheme) &&
+        uri.host.isNotEmpty;
+  }
+
+  MusicMetadata item(Entry entry, int index) => MusicMetadata(
+    songId: entry.id,
+    filePath: entry.id,
+    trackName: entry.title,
+    albumName: entry.id.startsWith('smbfile:') ? 'Home Server' : 'Radio',
+    originalSongIndex: index,
+    isOnDevice: false,
+  );
+}
