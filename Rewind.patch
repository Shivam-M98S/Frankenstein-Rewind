@@ -0,0 +1,19 @@
+Uri shareAddress(String input) {
+  var text = input.trim().replaceAll('\\', '/');
+  if (text.startsWith('//')) text = text.substring(2);
+  if (!text.contains('://')) text = 'smb://$text';
+  final uri = Uri.tryParse(text);
+  if (uri == null ||
+      uri.scheme != 'smb' ||
+      uri.host.isEmpty ||
+      uri.host.contains(RegExp(r'\s')) ||
+      uri.userInfo.isNotEmpty ||
+      uri.hasQuery ||
+      uri.hasFragment ||
+      (uri.hasPort && uri.port != 445)) {
+    throw const FormatException(
+      'Enter a server name, IP address, or Windows shared folder (server/share).',
+    );
+  }
+  return uri;
+}
