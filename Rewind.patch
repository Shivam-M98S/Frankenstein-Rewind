+import 'dart:async';
+
+import 'package:flutter/cupertino.dart';
+import 'package:flutter/services.dart';
+import 'package:permission_handler/permission_handler.dart';
+
+class LocalSpectrum extends StatefulWidget {
+  final int session;
+  const LocalSpectrum(this.session, {super.key});
+  @override
+  State<LocalSpectrum> createState() => _SpectrumState();
+}
+
+class _SpectrumState extends State<LocalSpectrum> {
+  static const channel = EventChannel('frankensteinrewind/spectrum');
+  StreamSubscription<dynamic>? sub;
+  List<int> bars = [];
+  @override
+  void initState() {
+    super.initState();
+    listen();
+  }
+
+  @override
+  void didUpdateWidget(LocalSpectrum old) {
+    super.didUpdateWidget(old);
+    if (old.session != widget.session) listen();
+  }
+
+  Future<void> listen() async {
+    final id = widget.session;
+    await sub?.cancel();
+    if (!mounted ||
+        id != widget.session ||
+        !await Permission.microphone.isGranted ||
+        !mounted ||
+        id != widget.session)
+      return;
+    sub = channel
+        .receiveBroadcastStream(id)
+        .listen(
+          (data) {
+            if (mounted) setState(() => bars = List<int>.from(data));
+          },
+          onError: (Object _) {
+            if (mounted) setState(() => bars = []);
+          },
+        );
+  }
+
+  @override
+  void dispose() {
+    sub?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => SizedBox(
+    height: 18,
+    child: Row(
+      crossAxisAlignment: CrossAxisAlignment.end,
+      children: [
+        for (final b in bars)
+          Expanded(
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 1),
+              child: ColoredBox(
+                color: CupertinoColors.activeGreen,
+                child: SizedBox(height: 1 + 17 * b / 100),
+              ),
+            ),
+          ),
+      ],
+    ),
+  );
+}
diff --git a/lib/features/rewind/spotify_session.dart b/lib/features/rewind/spotify_session.dart
new file mode 100644
index 0000000..6094f3f
--- /dev/null
+++ b/lib/features/rewind/spotify_session.dart
@@ -0,0 +1,99 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:spotify_sdk/spotify_sdk.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+
+final spotify = SpotifySession();
+
+class SpotifySession extends ChangeNotifier {
+  static const redirect = 'frankensteinrewind://auth';
+  final storage = const FlutterSecureStorage();
+  String track = '', artist = '', uri = '';
+  bool paused = true, active = false, connected = false;
+  Future<Uint8List?>? art;
+  StreamSubscription<dynamic>? subscription;
+  Future<void>? pending;
+
+  Future<String> token(String id, {bool renew = false}) async {
+    final key = 'rewind.spotify.$id';
+    if (!renew) {
+      final saved = await storage.read(key: key);
+      if (saved != null && saved.isNotEmpty) return saved;
+    }
+    final fresh = await SpotifySdk.getAccessToken(
+      clientId: id,
+      redirectUrl: redirect,
+      scope: 'app-remote-control,user-library-read,playlist-read-private,playlist-read-collaborative',
+    );
+    await storage.write(key: key, value: fresh);
+    return fresh;
+  }
+
+  Future<void> connect(String id) async {
+    if (connected) {
+      try {
+        if (await SpotifySdk.getPlayerState() != null) return;
+      } catch (_) {}
+      connected = false;
+    }
+    await (pending ??= _open(id).whenComplete(() => pending = null));
+  }
+
+  Future<void> _open(String id) async {
+    await subscription?.cancel();
+    connected = await SpotifySdk.connectToSpotifyRemote(
+      clientId: id,
+      redirectUrl: redirect,
+    );
+    if (!connected) throw StateError('Open Spotify and sign in, then retry.');
+    subscription = SpotifySdk.subscribePlayerState().listen(
+      (state) {
+        final song = state.track;
+        if (uri != (song?.uri ?? '')) {
+          final image = song?.imageUri;
+          art = image == null
+              ? null
+              : SpotifySdk.getImage(imageUri: image).catchError((_) => null);
+        }
+        uri = song?.uri ?? '';
+        track = song?.name ?? '';
+        artist = song?.artist.name ?? '';
+        paused = state.isPaused;
+        if (!paused && uri.isNotEmpty) active = true;
+        notifyListeners();
+      },
+      onError: (Object _) {
+        connected = false;
+        notifyListeners();
+      },
+      onDone: () {
+        connected = false;
+        notifyListeners();
+      },
+    );
+  }
+
+  void selectLocal() {
+    if (active) {
+      active = false;
+      notifyListeners();
+    }
+  }
+
+  Future<void> reset(String old) async {
+    await subscription?.cancel();
+    if (connected) await SpotifySdk.disconnect();
+    await storage.delete(key: 'rewind.spotify.$old');
+    connected = false;
+    active = false;
+    track = '';
+    artist = '';
+    uri = '';
+    art = null;
+    await rewindPrefs.remove('rewind.client');
+    notifyListeners();
+  }
+}
