+
+  Future<void> fetchLibrary(String name, {bool more = false}) async {
+    if (clientId.isEmpty)
+      throw StateError('Open Settings > Library > Spotify setup.');
+    final liked = name == 'Liked Songs';
+    final albums = name == 'Spotify albums';
+    final data = await spotifyLibrary.page(
+      clientId,
+      name,
+      next: more ? nextPage : null,
+    );
+    final records = <Entry>[];
+    for (final row in data['items'] as List) {
+      if (row is! Map) continue;
+      final item = liked
+          ? row['track']
+          : albums
+          ? row['album']
+          : row;
+      if (item is! Map || item['name'] is! String || item['uri'] is! String)
+        continue;
+      if (!(item['uri'] as String).startsWith(
+        liked
+            ? 'spotify:track:'
+            : albums
+            ? 'spotify:album:'
+            : 'spotify:playlist:',
+      ))
+        continue;
+      if (albums && item['images'] is List) {
+        for (final image in item['images']) {
+          if (image is Map &&
+              image['url'] is String &&
+              (image['url'] as String).startsWith('https://')) {
+            albumImages[item['uri'] as String] = image['url'] as String;
+            break;
+          }
+        }
+      }
+      records.add((title: item['name'] as String, id: item['uri'] as String));
+    }
+    if (!mounted) return;
+    if (!more) page(name);
+    setState(() {
+      library = more ? [...library, ...records] : records;
+      nextPage = data['next'] as String?;
+      if (library.isEmpty)
+        message = albums
+            ? 'Save an album in Spotify to see its cover here.'
+            : 'No items found.';
+    });
+  }
+
+  Future<void> toggle() async {
+    if (widget.initialUri == 'Radio' || widget.initialUri == 'Home Server') {
+      await ref.read(audioPlayerServiceProvider.notifier).togglePlayback();
+      return;
+    }
+    await connect();
+    if (spotify.paused) {
+      await spotify.resume();
+    } else {
+      await spotify.pause();
+    }
+  }
+
+  Future<void> choose(Entry entry) async {
+    final id = entry.id;
+    if (id.startsWith('option:')) {
+      final key = id.substring(7);
+      if (key == 'Local spectrum' &&
+          rewindPrefs.getBool(key) != true &&
+          !(await Permission.microphone.request()).isGranted)
+        throw StateError(
+          'Android needs audio permission to show the local spectrum.',
+        );
+      await rewindPrefs.setBool(key, !(rewindPrefs.getBool(key) ?? false));
+      rewindAppearance.value++;
+      refresh();
+      return;
+    }
+    if (id.startsWith('dir:')) {
+      await browseShare(id.substring(4));
+      folders.add(id.substring(4));
+      return;
+    }
+    if (id.startsWith('smbfile:') || networkLibrary.validStream(id)) {
+      await networkPlay(entry);
+      return;
+    }
+    if (section == 'Liked Songs' && id.startsWith('spotify:track:')) {
+      await connect();
+      await ref.read(audioPlayerServiceProvider.notifier).pause();
+      await spotify.play(spotifyUri: id);
+      spotify.active = true;
+      final following = library.skip(library.indexOf(entry) + 1).toList();
+      page('Now Playing');
+      for (final next in following) {
+        await spotify.queue(spotifyUri: next.id);
+      }
+      return;
+    }
+    switch (entry.id) {
+      case 'local-albums':
+        await context.pushNamed(Routes.coverFlow.name);
+        break;
+      case 'local-lists':
+        await context.pushNamed(Routes.playlists.name);
+        break;
+      case 'albums':
+        await fetchLibrary('Spotify albums');
+        break;
+      case 'skip':
+        await connect();
+        await spotify.skipNext();
+        break;
+      case 'previous':
+        await connect();
+        await spotify.skipPrevious();
+        break;
+      case 'authorize':
+        if (clientId.isEmpty && !await setup()) return;
+        await connect();
+        message = spotify.webPlayer && spotify.uri.isEmpty
+            ? 'Linked. Start a song in Spotify to activate your device.'
+            : 'Playback connected';
+      case 'allow-library':
+        if (clientId.isEmpty && !await setup()) return;
+        await spotifyLibrary.page(clientId, 'Playlists', limit: 1);
+        message = 'Library connected';
+      case 'disconnect':
+        await spotify.reset(clientId);
+        message = 'Disconnected';
+      case 'configure-share':
+        final address = await prompt('Server IP or server/share', '');
+        if (address == null) return;
+        final user = await prompt('Username (blank for guest)', '');
+        if (user == null) return;
+        final password = user.trim().isEmpty
+            ? ''
+            : await prompt('Password', '', secret: true);
+        if (password == null) return;
+        await networkLibrary.configure(address, user, password);
+        message = 'Connected';
+      case 'browse-share':
+        await browseShare('');
+      case 'suriname':
+        final items = await networkLibrary.stations(country: 'SR');
+        page('Suriname');
+        library = items;
+      case 'country':
+        final code = await prompt('Two-letter country code (SR, US, NL)', '');
+        if (code == null) return;
+        if (!RegExp(r'^[A-Za-z]{2}$').hasMatch(code))
+          throw FormatException('Enter two letters.');
+        final items = await networkLibrary.stations(
+          country: code.toUpperCase(),
+        );
+        page(code.toUpperCase());
+        library = items;
+        if (items.isEmpty) message = 'No stations found for this country.';
+      case 'search':
+        final name = await prompt('Station name', '');
+        if (name == null) return;
+        final items = await networkLibrary.stations(query: name);
+        page('Stations');
+        library = items;
+        if (items.isEmpty) message = 'No stations matched that name.';
+      case 'favorites':
+        page('Favorites');
+        library = networkLibrary.favorites;
+      case 'stream':
+        final url = await prompt('Stream URL', 'https://');
+        if (url == null) return;
+        if (!networkLibrary.validStream(url))
+          throw FormatException('Enter an HTTP or HTTPS stream.');
+        final name = await prompt('Station name', '');
+        if (name == null || name.isEmpty) return;
+        await networkLibrary.favorite((title: name, id: url), true);
+        page('Favorites');
+        library = networkLibrary.favorites;
+      case 'night':
+        final next = !rewindNight.value;
+        await rewindPrefs.setBool('rewind.night', next);
+        rewindNight.value = next;
+      case 'pin-link':
+        final link = await prompt('Spotify playlist link', '');
+        if (link == null || !mounted) return;
+        final pattern = RegExp(
+          r'^(?:spotify:playlist:|https://open\.spotify\.com/(?:intl-[^/]+/)?playlist/)([A-Za-z0-9]{22})(?:[/?#].*)?$',
+        );
+        final match = pattern.firstMatch(link.trim());
+        if (match == null)
+          throw StateError('Use a playlist link copied from Spotify.');
+        final name = await prompt('Home shortcut name', '');
+        if (name != null && name.trim().isNotEmpty)
+          await savePin('spotify:playlist:${match[1]}', name.trim());
+      case 'setup':
+        await setup();
+      case 'lists':
+        await fetchLibrary('Playlists');
+      case 'liked':
+        await fetchLibrary('Liked Songs');
+      case 'more':
+        await fetchLibrary(section, more: true);
+      case 'now':
+        await connect();
+        page('Now Playing');
+      case 'toggle':
+        await toggle();
+      case 'open':
+        final parts = trackUri.split(':');
+        if (parts.length == 3)
+          await launchUrl(
+            Uri.https('open.spotify.com', '/${parts[1]}/${parts[2]}'),
+            mode: LaunchMode.externalApplication,
+          );
+      default:
+        await play(entry.id);
+    }
+  }
+
+  Future<void> hold(Entry entry) async {
+    if (networkLibrary.validStream(entry.id)) {
+      final add = !networkLibrary.favorites.any((s) => s.id == entry.id);
+      await networkLibrary.favorite(entry, add);
