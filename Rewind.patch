diff --git a/lib/features/rewind/rewind_preferences.dart b/lib/features/rewind/rewind_preferences.dart
new file mode 100644
index 0000000..ef5b233
--- /dev/null
+++ b/lib/features/rewind/rewind_preferences.dart
@@ -0,0 +1,30 @@
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+final rewindNight = ValueNotifier<bool>(false);
+final rewindPins = ValueNotifier<Map<String, String>>({});
+late SharedPreferences rewindPrefs;
+
+Future<void> loadRewindPreferences() async {
+  rewindPrefs = await SharedPreferences.getInstance();
+  rewindNight.value = rewindPrefs.getBool('rewind.night') ?? false;
+  final saved = rewindPrefs.getString('rewind.pins');
+  if (saved != null) {
+    rewindPins.value = Map<String, String>.from(jsonDecode(saved) as Map);
+  }
+}
+
+Future<void> savePin(String uri, String? name) async {
+  final next = {...rewindPins.value};
+  if (name == null) {
+    next.remove(uri);
+  } else {
+    next[uri] = name;
+  }
+  if (!await rewindPrefs.setString('rewind.pins', jsonEncode(next))) {
+    throw StateError('Could not save your shortcuts.');
+  }
+  rewindPins.value = next;
+}
diff --git a/lib/features/rewind/rewind_screen.dart b/lib/features/rewind/rewind_screen.dart
new file mode 100644
index 0000000..b9867a8
--- /dev/null
+++ b/lib/features/rewind/rewind_screen.dart
@@ -0,0 +1,518 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:classipod/core/navigation/routes.dart';
+import 'package:classipod/core/extensions/go_router_extensions.dart';
+import 'package:classipod/features/custom_screen_elements/custom_screen.dart';
+import 'package:classipod/features/device/models/device_action.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+import 'package:flutter/cupertino.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+import 'package:http/http.dart' as http;
+import 'package:spotify_sdk/spotify_sdk.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+class RewindScreen extends ConsumerStatefulWidget {
+  const RewindScreen({super.key, this.initialUri});
+  final String? initialUri;
+  @override
+  ConsumerState<RewindScreen> createState() => _RewindState();
+}
+
+typedef Entry = ({String title, String id});
+
+class _RewindState extends ConsumerState<RewindScreen> with CustomScreen {
+  String section = 'Spotify';
+  String message = '';
+  String token = '';
+  String track = '';
+  String artist = '';
+  String trackUri = '';
+  Future<Uint8List?>? art;
+  bool paused = true;
+  bool busy = false;
+  bool connected = false;
+  String? nextPage;
+  List<Entry> library = [];
+  StreamSubscription<dynamic>? subscription;
+  final client = http.Client();
+  static const redirect = 'frankensteinrewind://auth';
+  static const rowHeight = 34.0;
+
+  @override
+  String get routeName => Routes.rewind.name;
+  @override
+  List<Entry> get displayItems {
+    if (section == 'Spotify') {
+      return [
+        for (final pin in rewindPins.value.entries)
+          (title: pin.value, id: pin.key),
+        (title: 'Liked Songs', id: 'liked'),
+        (title: 'Playlists', id: 'lists'),
+        (title: 'Now Playing', id: 'now'),
+        (
+          title: 'Night Drive - ${rewindNight.value ? "On" : "Off"}',
+          id: 'night',
+        ),
+        (title: 'Pin playlist link', id: 'pin-link'),
+        (title: 'Spotify setup', id: 'setup'),
+      ];
+    }
+    if (section == 'Now Playing') {
+      return [
+        (title: paused ? 'Resume' : 'Pause', id: 'toggle'),
+        if (trackUri.isNotEmpty) (title: 'Open in Spotify', id: 'open'),
+      ];
+    }
+    return [...library, if (nextPage != null) (title: 'Load more', id: 'more')];
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.initialUri != null) {
+      WidgetsBinding.instance.addPostFrameCallback(
+        (_) => run(() => play(widget.initialUri!)),
+      );
+    }
+  }
+
+  @override
+  void dispose() {
+    subscription?.cancel();
+    client.close();
+    super.dispose();
+  }
+
+  Future<void> run(Future<void> Function() action) async {
+    if (busy || !mounted) return;
+    setState(() {
+      busy = true;
+      message = '';
+    });
+    try {
+      await action();
+    } catch (e) {
+      if (mounted) setState(() => message = e.toString());
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  Future<String?> prompt(String title, String initial) async {
+    var value = initial;
+    return showCupertinoDialog<String>(
+      context: context,
+      builder: (c) => CupertinoAlertDialog(
+        title: Text(title),
+        content: CupertinoTextFormFieldRow(
+          initialValue: initial,
+          autocorrect: false,
+          onChanged: (s) => value = s.trim(),
+        ),
+        actions: [
+          CupertinoDialogAction(
+            onPressed: () => Navigator.pop(c),
+            child: const Text('Cancel'),
+          ),
+          CupertinoDialogAction(
+            onPressed: () => Navigator.pop(c, value),
+            child: const Text('Save'),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Future<bool> setup() async {
+    final old = rewindPrefs.getString('rewind.client') ?? '';
+    final value = await prompt('Spotify public client ID', old);
+    if (value == null) return false;
+    if (!RegExp(r'^[a-fA-F0-9]{32}$').hasMatch(value))
+      throw StateError('Enter the 32-character public client ID.');
+    if (value != old) {
+      await subscription?.cancel();
+      if (connected) await SpotifySdk.disconnect();
+      connected = false;
+      token = '';
+    }
+    await rewindPrefs.setString('rewind.client', value);
+    return true;
+  }
+
+  Future<void> connect({bool libraryAccess = false}) async {
+    var id = rewindPrefs.getString('rewind.client') ?? '';
+    if (id.isEmpty) {
+      if (!await setup()) throw StateError('Spotify setup cancelled.');
+      id = rewindPrefs.getString('rewind.client')!;
+    }
+    if (libraryAccess && token.isEmpty) {
+      token = await SpotifySdk.getAccessToken(
+        clientId: id,
+        redirectUrl: redirect,
+        scope: 'app-remote-control,user-library-read,playlist-read-private,playlist-read-collaborative',
+      );
+    }
+    if (connected) return;
+    connected = await SpotifySdk.connectToSpotifyRemote(
+      clientId: id,
+      redirectUrl: redirect,
+    );
+    if (!connected) throw StateError('Open Spotify, sign in, then retry.');
+    await subscription?.cancel();
+    subscription = SpotifySdk.subscribePlayerState().listen(
+      (state) {
+        if (!mounted) return;
+        setState(() {
+          paused = state.isPaused;
+          track = state.track?.name ?? '';
+          artist = state.track?.artist.name ?? '';
+          final uri = state.track?.uri ?? '';
+          if (uri != trackUri) {
+            final image = state.track?.imageUri;
+            art = image == null ? null : SpotifySdk.getImage(imageUri: image);
+          }
+          trackUri = uri;
+        });
+      },
+      onError: (Object e) {
+        if (mounted)
+          setState(() {
+            connected = false;
+            message = e.toString();
+          });
+      },
+      onDone: () {
+        connected = false;
+      },
+    );
+  }
+
+  void page(String name) {
+    if (!mounted) return;
+    setState(() {
+      section = name;
+      selectedDisplayItem = 0;
+      message = '';
+    });
+    if (scrollController.hasClients) scrollController.jumpTo(0);
+  }
+
+  Future<void> play(String uri) async {
+    await connect();
+    await SpotifySdk.play(spotifyUri: uri);
+    page('Now Playing');
+  }
+
+  Future<void> fetchLibrary(String name, {bool more = false}) async {
+    await connect(libraryAccess: true);
+    final liked = name == 'Liked Songs';
+    final endpoint = Uri.parse(
+      more
+          ? nextPage!
+          : 'https://api.spotify.com/v1/me/${liked ? "tracks" : "playlists"}?limit=50',
+    );
+    if (endpoint.scheme != 'https' || endpoint.host != 'api.spotify.com')
+      throw StateError('Unexpected Spotify endpoint.');
+    final response = await client
+        .get(endpoint, headers: {'Authorization': 'Bearer $token'})
+        .timeout(const Duration(seconds: 20));
+    if (response.statusCode == 401) token = '';
+    if (response.statusCode != 200)
+      throw StateError(
+        'Spotify library request returned ${response.statusCode}. Check account access and retry.',
+      );
+    final data = jsonDecode(response.body) as Map;
+    final records = <Entry>[];
+    for (final row in data['items'] as List) {
+      if (row is! Map) continue;
+      final item = liked ? row['track'] : row;
+      if (item is! Map || item['name'] is! String || item['uri'] is! String)
+        continue;
+      if (!(item['uri'] as String).startsWith(
+        liked ? 'spotify:track:' : 'spotify:playlist:',
+      ))
+        continue;
+      records.add((title: item['name'] as String, id: item['uri'] as String));
+    }
+    if (!mounted) return;
+    if (!more) page(name);
+    setState(() {
+      library = more ? [...library, ...records] : records;
+      nextPage = data['next'] as String?;
+      if (library.isEmpty) message = 'No items found.';
+    });
+  }
+
+  Future<void> toggle() async {
+    await connect();
+    final state = await SpotifySdk.getPlayerState();
+    if (state == null) throw StateError('Spotify player is unavailable.');
+    if (state.isPaused) {
+      await SpotifySdk.resume();
+    } else {
+      await SpotifySdk.pause();
+    }
+  }
+
+  Future<void> choose(Entry entry) async {
+    switch (entry.id) {
+      case 'night':
+        final next = !rewindNight.value;
+        await rewindPrefs.setBool('rewind.night', next);
+        rewindNight.value = next;
+      case 'pin-link':
+        final link = await prompt('Spotify playlist link', '');
+        if (link == null || !mounted) return;
+        final pattern = RegExp(
+          r'^(?:spotify:playlist:|https://open\.spotify\.com/(?:intl-[^/]+/)?playlist/)([A-Za-z0-9]{22})(?:[/?#].*)?$',
+        );
+        final match = pattern.firstMatch(link.trim());
+        if (match == null)
+          throw StateError('Use a playlist link copied from Spotify.');
+        final name = await prompt('Home shortcut name', '');
+        if (name != null && name.trim().isNotEmpty)
+          await savePin('spotify:playlist:${match[1]}', name.trim());
+      case 'setup':
+        await setup();
+      case 'lists':
+        await fetchLibrary('Playlists');
+      case 'liked':
+        await fetchLibrary('Liked Songs');
+      case 'more':
+        await fetchLibrary(section, more: true);
+      case 'now':
+        await connect();
+        page('Now Playing');
+      case 'toggle':
+        await toggle();
+      case 'open':
+        final parts = trackUri.split(':');
+        if (parts.length == 3)
+          await launchUrl(
+            Uri.https('open.spotify.com', '/${parts[1]}/${parts[2]}'),
+            mode: LaunchMode.externalApplication,
+          );
+      default:
+        await play(entry.id);
+    }
+  }
+
+  Future<void> hold(Entry entry) async {
+    final pin = entry.id.startsWith('spotify:playlist:');
+    if (!pin && !entry.id.startsWith('spotify:track:')) return;
+    final saved = rewindPins.value.containsKey(entry.id);
+    final action = await showCupertinoModalPopup<String>(
+      context: context,
+      builder: (c) => CupertinoActionSheet(
+        title: Text(entry.title),
+        actions: [
+          CupertinoActionSheetAction(
+            onPressed: () => Navigator.pop(c, 'save'),
+            child: Text(
+              pin
+                  ? (saved ? 'Rename shortcut' : 'Pin to Home')
+                  : 'Add to queue',
+            ),
+          ),
+          if (pin && saved)
+            CupertinoActionSheetAction(
+              onPressed: () => Navigator.pop(c, 'remove'),
+              child: const Text('Unpin'),
+            ),
+        ],
+        cancelButton: CupertinoActionSheetAction(
+          onPressed: () => Navigator.pop(c),
+          child: const Text('Cancel'),
+        ),
+      ),
+    );
+    if (!mounted || action == null) return;
+    if (!pin) {
+      await connect();
+      await SpotifySdk.queue(spotifyUri: entry.id);
+      if (mounted) setState(() => message = 'Queued - ${entry.title}');
+    } else if (action == 'remove') {
+      await savePin(entry.id, null);
+      if (mounted) setState(() => selectedDisplayItem = 0);
+    } else {
+      final name = await prompt(
+        'Home shortcut name',
+        rewindPins.value[entry.id] ?? entry.title,
+      );
+      if (name != null && name.trim().isNotEmpty)
+        await savePin(entry.id, name.trim());
+    }
+  }
+
+  @override
+  void onMenuButtonPressed() {
+    if (busy) return;
+    if (section == 'Spotify') {
+      context.pop();
+    } else {
+      page('Spotify');
+    }
+  }
+
+  @override
+  void onSelectPressed() {
+    if (displayItems.isNotEmpty)
+      run(() => choose(displayItems[selectedDisplayItem]));
+  }
+
+  @override
+  void onSelectLongPress() {
+    if (displayItems.isNotEmpty)
+      run(() => hold(displayItems[selectedDisplayItem]));
+  }
+
+  @override
+  Future<void> seekForward() => run(() async {
+    await connect();
+    await SpotifySdk.skipNext();
+  });
+  @override
+  Future<void> seekBackward() => run(() async {
+    await connect();
+    await SpotifySdk.skipPrevious();
+  });
+  @override
+  Future<void> deviceControlHandler(dynamic old, DeviceAction? action) async {
+    if (action == DeviceAction.playPause &&
+        mounted &&
+        GoRouter.of(context).locationNamed == routeName &&
+        ModalRoute.of(context)?.isCurrent == true) {
+      await run(toggle);
+      return;
+    }
+    await super.deviceControlHandler(old, action);
+  }
+
+  void move(int delta) {
+    if (busy || displayItems.isEmpty) return;
+    setState(
+      () => selectedDisplayItem = (selectedDisplayItem + delta).clamp(
+        0,
+        displayItems.length - 1,
+      ),
+    );
+    if (scrollController.hasClients) {
+      final pos = scrollController.position;
+      final y = selectedDisplayItem * rowHeight;
+      if (y < pos.pixels ||
+          y + rowHeight > pos.pixels + pos.viewportDimension) {
+        scrollController.jumpTo(y.clamp(0, pos.maxScrollExtent));
+      }
+    }
+  }
+
+  @override
+  void scrollForward() => move(1);
+  @override
+  void scrollBackward() => move(-1);
+
+  @override
+  Widget build(BuildContext context) {
+    final night = rewindNight.value;
+    final ink = night ? const Color(0xffefb26e) : const Color(0xff182027);
+    final paper = night ? const Color(0xff151515) : const Color(0xfff8f9fa);
+    final rows = displayItems;
+    return ColoredBox(
+      color: paper,
+      child: DefaultTextStyle(
+        style: TextStyle(color: ink, fontSize: 15),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
+              child: Text(
+                section,
+                style: const TextStyle(fontWeight: FontWeight.bold),
+              ),
+            ),
+            if (section == 'Now Playing')
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 8),
+                child: Row(
+                  children: [
+                    if (art != null)
+                      FutureBuilder<Uint8List?>(
+                        future: art,
+                        builder: (context, snapshot) {
+                          final bytes = snapshot.data;
+                          return bytes == null
+                              ? const SizedBox.shrink()
+                              : Padding(
+                                  padding: const EdgeInsets.only(right: 8),
+                                  child: Image.memory(
+                                    bytes,
+                                    width: 48,
+                                    height: 48,
+                                    fit: BoxFit.contain,
+                                  ),
+                                );
+                        },
+                      ),
+                    Expanded(
+                      child: Text(
+                        [
+                          track.isEmpty ? 'No track selected' : track,
+                          artist,
+                        ].where((s) => s.isNotEmpty).join('\n'),
+                        maxLines: 3,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(fontSize: night ? 20 : 17),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            if (busy || message.isNotEmpty)
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 8),
+                child: Text(
+                  busy ? 'Connecting.' : message,
+                  maxLines: 3,
+                  overflow: TextOverflow.ellipsis,
+                ),
+              ),
+            Expanded(
+              child: ListView.builder(
+                controller: scrollController,
+                itemExtent: rowHeight,
+                itemCount: rows.length,
+                itemBuilder: (c, i) => GestureDetector(
+                  behavior: HitTestBehavior.opaque,
+                  onTap: () {
+                    if (!busy) {
+                      setState(() => selectedDisplayItem = i);
+                      run(() => choose(rows[i]));
+                    }
+                  },
+                  onLongPress: () => run(() => hold(rows[i])),
+                  child: Container(
+                    alignment: Alignment.centerLeft,
+                    padding: const EdgeInsets.symmetric(horizontal: 8),
+                    color: i == selectedDisplayItem ? ink : paper,
+                    child: Text(
+                      rows[i].title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: TextStyle(
+                        color: i == selectedDisplayItem ? paper : ink,
+                      ),
+                    ),
+                  ),
+                ),
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
