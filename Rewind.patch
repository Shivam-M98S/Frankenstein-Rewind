+import 'package:classipod/features/rewind/spotify_art.dart';
+import 'package:permission_handler/permission_handler.dart';
+import 'package:classipod/core/extensions/build_context_extensions.dart';
+import 'package:classipod/core/services/audio_player_service.dart';
+import 'package:classipod/features/now_playing/models/now_playing_model.dart';
+
+import 'network_library.dart';
+import 'spotify_session.dart';
+
+import 'dart:async';
+
+import 'package:classipod/features/rewind/spotify_library.dart';
+import 'package:flutter/services.dart' show PlatformException;
+import 'package:classipod/features/rewind/spotify_setup.dart';
+
+import 'package:classipod/core/navigation/routes.dart';
+import 'package:classipod/core/extensions/go_router_extensions.dart';
+import 'package:classipod/features/custom_screen_elements/custom_screen.dart';
+import 'package:classipod/features/device/models/device_action.dart';
+import 'package:classipod/features/rewind/rewind_preferences.dart';
+import 'package:flutter/cupertino.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+class RewindScreen extends ConsumerStatefulWidget {
+  const RewindScreen({super.key, this.initialUri});
+  final String? initialUri;
+  @override
+  ConsumerState<RewindScreen> createState() => _RewindState();
+}
+
+class _RewindState extends ConsumerState<RewindScreen> with CustomScreen {
+  String section = 'Spotify';
+  String message = '';
+  String get track => spotify.track;
+  String get trackUri => spotify.uri;
+  String get artist => spotify.artist;
+  bool get paused => spotify.paused;
+  bool busy = false;
+  final albumImages = <String, String>{};
+  final carousel = PageController(viewportFraction: 0.72);
+  final folders = <String>[];
+  String? nextPage;
+  List<Entry> library = [];
+
+  final spotifyLibrary = SpotifyLibrary(spotify.token);
+  static const rowHeight = 34.0;
+
+  @override
+  String get routeName => Routes.rewind.name;
+  @override
+  List<Entry> get displayItems {
+    if (section == 'Album sources')
+      return [
+        (title: 'Spotify albums', id: 'albums'),
+        (title: 'Device library', id: 'local-albums'),
+      ];
+    if (section == 'Playlist sources')
+      return [
+        (title: 'Spotify playlists', id: 'lists'),
+        (title: 'Device playlists', id: 'local-lists'),
+      ];
+    if (section == 'Experimental')
+      return [
+        for (final key in ['Liquid Glass', 'S10 Edge', 'Local spectrum'])
+          (
+            title: '$key ? ${rewindPrefs.getBool(key) == true ? 'On' : 'Off'}',
+            id: 'option:$key',
+          ),
+      ];
+    if (section == 'Spotify setup')
+      return [
+        (
+          title: clientId.isEmpty ? 'Add client ID' : 'Change client ID',
+          id: 'setup',
+        ),
+        (title: 'Connect playback', id: 'authorize'),
+        (title: 'Allow library access', id: 'allow-library'),
+        (title: 'Disconnect', id: 'disconnect'),
+      ];
+    if (section == 'Shared folder setup')
+      return [
+        (title: 'Add or change shared folder', id: 'configure-share'),
+        (title: 'Browse shared folder', id: 'browse-share'),
+      ];
+    if (section == 'Radio')
+      return [
+        (title: 'Suriname', id: 'suriname'),
+        (title: 'Browse by country', id: 'country'),
+        (title: 'Search stations', id: 'search'),
+        (title: 'Favorites', id: 'favorites'),
+        (title: 'Add stream URL', id: 'stream'),
+      ];
+    if (section == 'Spotify') {
+      return [
+        for (final pin in rewindPins.value.entries)
+          (title: pin.value, id: pin.key),
+        (title: 'Liked Songs', id: 'liked'),
+        (title: 'Playlists', id: 'lists'),
+        (title: 'Now Playing', id: 'now'),
+        (
+          title: 'Night Drive - ${rewindNight.value ? "On" : "Off"}',
+          id: 'night',
+        ),
+      ];
+    }
+    if (section == 'Now Playing') {
+      return [
+        (title: paused ? 'Resume' : 'Pause', id: 'toggle'),
+        (title: 'Next track', id: 'skip'),
+        (title: 'Previous track', id: 'previous'),
+        (title: 'Browse playlists', id: 'lists'),
+        if (trackUri.isNotEmpty) (title: 'Open in Spotify', id: 'open'),
+      ];
+    }
+    return [...library, if (nextPage != null) (title: 'Load more', id: 'more')];
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    spotify.addListener(refresh);
+    final initial = widget.initialUri;
+    if (initial != null) {
+      if (initial.startsWith('spotify:')) {
+        WidgetsBinding.instance.addPostFrameCallback(
+          (_) => run(() => play(initial)),
+        );
+      } else {
+        section = initial;
+        if (initial == 'Home Server')
+          WidgetsBinding.instance.addPostFrameCallback(
+            (_) => run(() => browseShare('')),
+          );
+        if (initial == 'Now Playing')
+          WidgetsBinding.instance.addPostFrameCallback((_) => run(connect));
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    carousel.dispose();
+    spotify.removeListener(refresh);
+    spotifyLibrary.close();
+    super.dispose();
+  }
+
+  void refresh() {
+    if (mounted) setState(() {});
+  }
+
+  Future<void> browseShare(String path) async {
+    final items = await networkLibrary.files(path);
+    page('Home Server');
+    library = items;
+  }
+
+  Future<void> networkPlay(Entry selected) async {
+    final entries = selected.id.startsWith('smbfile:')
+        ? library.where((e) => e.id.startsWith('smbfile:')).toList()
+        : [selected];
+    final service = ref.read(audioPlayerServiceProvider.notifier);
+    if (spotify.active && !spotify.paused) {
+      try {
+        await spotify.pause();
+      } catch (_) {
+        /* An offline Spotify session must not block another player. */
+      }
+    }
+    spotify.selectLocal();
+    await service.setAudioSource(
+      preload: false,
+      musicMetadataList: [
+        for (var i = 0; i < entries.length; i++)
+          networkLibrary.item(entries[i], i),
+      ],
+      nowPlayingType: NowPlayingType.playlist,
+    );
+    ref.read(audioPlayerServiceProvider).requireValue;
+    await ref
+        .read(libraryAudioHandlerProvider)
+        .select(entries.indexOf(selected));
+    if (mounted)
+      await context.pushNamed(
+        Routes.nowPlaying.name,
+        extra: Routes.rewind.name,
+      );
+  }
+
+  Future<void> run(Future<void> Function() action) async {
+    if (busy || !mounted) return;
+    setState(() {
+      busy = true;
+      message = '';
+    });
+    try {
+      await action();
+    } on PlatformException catch (e) {
+      final isSpotify = const {
+        'Spotify',
+        'Spotify setup',
+        'Liked Songs',
+        'Playlists',
+        'Spotify albums',
+        'Album sources',
+        'Playlist sources',
+        'Now Playing',
+      }.contains(section);
+      if (mounted) {
+        setState(
+          () => message = isSpotify
+              ? spotifySetupHint(e.code, e.message)
+              : e.toString(),
+        );
+      }
+    } catch (e) {
+      if (mounted)
+        setState(() => message = e is StateError ? e.message : e.toString());
