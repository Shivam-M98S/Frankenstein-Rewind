+      ),
+    );
+  }
+
+  Future<bool> setup() async {
+    final old = clientId;
+    final value = await prompt('Spotify public client ID', old);
+    if (value == null) return false;
+    if (!RegExp(r'^[a-fA-F0-9]{32}$').hasMatch(value))
+      throw StateError('Enter the 32-character public client ID.');
+    if (value != old) {
+      await spotify.reset(old);
