+      }
+      return;
+    }
+    switch (entry.id) {
+      case 'authorize':
+        await connect();
+        message = 'Connected';
+      case 'disconnect':
+        await spotify.reset(clientId);
+        message = 'Disconnected';
+      case 'configure-share':
+        final address = await prompt('Shared folder address', 'smb://');
+        if (address == null) return;
+        final user = await prompt('Username (blank for guest)', '');
+        if (user == null) return;
+        final password = await prompt('Password', '', secret: true);
+        if (password == null) return;
+        await networkLibrary.configure(address, user, password);
+        message = 'Connected';
+      case 'browse-share':
