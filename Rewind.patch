+++ b/lib/features/rewind/spectrum.dart
@@ -0,0 +1,76 @@
+import 'dart:async';
+
+import 'package:flutter/cupertino.dart';
+import 'package:flutter/services.dart';
+import 'package:permission_handler/permission_handler.dart';
+
+class LocalSpectrum extends StatefulWidget {
+  final int session;
+  const LocalSpectrum(this.session, {super.key});
+  @override
+  State<LocalSpectrum> createState() => _SpectrumState();
+}
+
+class _SpectrumState extends State<LocalSpectrum> {
+  static const channel = EventChannel('frankensteinrewind/spectrum');
+  StreamSubscription<dynamic>? sub;
+  List<int> bars = [];
+  @override
+  void initState() {
+    super.initState();
+    listen();
+  }
+
+  @override
+  void didUpdateWidget(LocalSpectrum old) {
+    super.didUpdateWidget(old);
+    if (old.session != widget.session) listen();
+  }
+
+  Future<void> listen() async {
+    final id = widget.session;
+    await sub?.cancel();
+    if (!mounted ||
+        id != widget.session ||
+        !await Permission.microphone.isGranted ||
+        !mounted ||
+        id != widget.session)
+      return;
+    sub = channel
+        .receiveBroadcastStream(id)
+        .listen(
+          (data) {
+            if (mounted) setState(() => bars = List<int>.from(data));
+          },
+          onError: (Object _) {
+            if (mounted) setState(() => bars = []);
+          },
+        );
+  }
+
+  @override
+  void dispose() {
+    sub?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => SizedBox(
+    height: 18,
+    child: Row(
+      crossAxisAlignment: CrossAxisAlignment.end,
+      children: [
+        for (final b in bars)
+          Expanded(
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 1),
+              child: ColoredBox(
+                color: CupertinoColors.activeGreen,
+                child: SizedBox(height: 1 + 17 * b / 100),
+              ),
+            ),
+          ),
+      ],
+    ),
+  );
+}
