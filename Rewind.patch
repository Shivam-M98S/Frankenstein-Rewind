+  Future<void> fetchLibrary(String name, {bool more = false}) async {
+    if (clientId.isEmpty)
+      throw StateError('Open Settings  Library  Spotify setup.');
+    var token = await spotify.token(clientId);
+    final liked = name == 'Liked Songs';
+    final endpoint = Uri.parse(
+      more
+          ? nextPage!
+          : 'https://api.spotify.com/v1/me/${liked ? "tracks" : "playlists"}?limit=50',
+    );
+    if (endpoint.scheme != 'https' || endpoint.host != 'api.spotify.com')
+      throw StateError('Unexpected Spotify endpoint.');
+    var response = await client
+        .get(endpoint, headers: {'Authorization': 'Bearer $token'})
+        .timeout(const Duration(seconds: 20));
+    if (response.statusCode == 401) {
+      token = await spotify.token(clientId, renew: true);
+      response = await client
+          .get(endpoint, headers: {'Authorization': 'Bearer $token'})
+          .timeout(const Duration(seconds: 20));
+    }
+    if (response.statusCode != 200)
+      throw StateError(
+        'Spotify library request returned ${response.statusCode}. Check account access and retry.',
+      );
+    final data = jsonDecode(response.body) as Map;
