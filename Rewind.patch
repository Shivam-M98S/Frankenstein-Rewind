diff --git a/test/unit_tests/rewind/network_sources_test.dart b/test/unit_tests/rewind/network_sources_test.dart
new file mode 100644
index 0000000..b15a4a6
--- /dev/null
+++ b/test/unit_tests/rewind/network_sources_test.dart
@@ -0,0 +1,120 @@
+import 'dart:io';
+import 'dart:convert';
+
+import 'package:classipod/features/rewind/network_library.dart';
+import 'package:classipod/features/rewind/share_address.dart';
+import 'package:classipod/features/rewind/spotify_oauth.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
+
+class TestPaths extends PathProviderPlatform {
+  final String directory;
+  TestPaths(this.directory);
+  @override
+  Future<String?> getTemporaryPath() async => directory;
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test('Windows, host-only and SMB address forms', () {
+    expect(shareAddress(r'\\nas\Music files').pathSegments, ['Music files']);
+    expect(shareAddress('192.168.1.30').host, '192.168.1.30');
+    expect(shareAddress('smb://nas/share/sub').path, '/share/sub');
+    expect(() => shareAddress('https://host/folder'), throwsFormatException);
+  });
+  test('PKCE agrees with the RFC 7636 test vector', () {
+    expect(
+      pkceChallenge('dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk'),
+      'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM',
+    );
+  });
+  test(
+    'Suriname stations are playable URLs without a directory request',
+    () async {
+      final hits = await NetworkLibrary().stations(country: 'SR');
+      expect(hits.map((e) => e.title), contains('Radio Apintie'));
+      expect(hits.every((e) => Uri.parse(e.id).scheme == 'https'), isTrue);
+    },
+  );
+  test(
+    'Saved authorization refreshes once and is reused without sign-in',
+    () async {
+      FlutterSecureStorage.setMockInitialValues({
+        'rewind.pkce.test': jsonEncode({
+          'access': 'expired',
+          'refresh': 'saved-refresh',
+          'expires': 0,
+        }),
+      });
+      var requests = 0;
+      final oauth = SpotifyOAuth(
+        client: MockClient((request) async {
+          requests++;
+          expect(request.url.host, 'accounts.spotify.com');
+          expect(request.bodyFields['grant_type'], 'refresh_token');
+          expect(request.bodyFields['refresh_token'], 'saved-refresh');
+          return http.Response(
+            jsonEncode({'access_token': 'renewed', 'expires_in': 3600}),
+            200,
+          );
+        }),
+      );
+      expect(
+        await oauth.token(
+          'test',
+          'frankensteinrewindpreview://auth',
+          interactive: false,
+        ),
+        'renewed',
+      );
+      expect(
+        await oauth.token(
+          'test',
+          'frankensteinrewindpreview://auth',
+          interactive: false,
+        ),
+        'renewed',
+      );
+      expect(requests, 1);
+      final saved = jsonDecode(
+        (await oauth.storage.read(key: 'rewind.pkce.test'))!,
+      );
+      expect(saved['refresh'], 'saved-refresh');
+    },
+  );
+  test('Background polling never opens a login prompt', () async {
+    FlutterSecureStorage.setMockInitialValues({});
+    await expectLater(
+      SpotifyOAuth().token(
+        'test',
+        'frankensteinrewindpreview://auth',
+        interactive: false,
+      ),
+      throwsStateError,
+    );
+  });
+  test('Samba guest and password shares list and read audio bytes', () async {
+    FlutterSecureStorage.setMockInitialValues({});
+    final tmp = await Directory.systemTemp.createTemp('rewind-test-');
+    PathProviderPlatform.instance = TestPaths(tmp.path);
+    addTearDown(() => tmp.delete(recursive: true));
+    final net = NetworkLibrary();
+    addTearDown(() async => net.share?.close());
+    for (final user in ['', 'rewindtest']) {
+      await net.configure(
+        '127.0.0.1/' + (user.isEmpty ? 'public' : 'private'),
+        user,
+        user.isEmpty ? '' : 'test-only',
+      );
+      final tracks = await net.files('');
+      final song = tracks.singleWhere((e) => e.title == 'fixture.mp3');
+      expect(
+        await (await net.cacheTrack(song.id.substring(8))).readAsString(),
+        'fixture',
+      );
+    }
+  }, skip: Platform.environment['REWIND_SMB_FIXTURE'] != '1');
+}
diff --git a/test/unit_tests/rewind/spotify_setup_test.dart b/test/unit_tests/rewind/spotify_setup_test.dart
new file mode 100644
index 0000000..885db7e
--- /dev/null
+++ b/test/unit_tests/rewind/spotify_setup_test.dart
@@ -0,0 +1,66 @@
+import 'package:classipod/features/rewind/spotify_library.dart';
+import 'package:classipod/features/rewind/spotify_setup.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+
+void main() {
+  test('existing client ID overrides a bundled public ID', () {
+    expect(resolveSpotifyClientId(' mine ', 'shared'), 'mine');
+    expect(resolveSpotifyClientId(null, 'shared'), 'shared');
+    expect(resolveSpotifyClientId(null, ''), isEmpty);
+  });
+
+  test('library renews once after an expired access token', () async {
+    final renewals = <bool>[];
+    final library = SpotifyLibrary(
+      (id, {bool renew = false}) async {
+        renewals.add(renew);
+        return renew ? 'new' : 'old';
+      },
+      client: MockClient((request) async {
+        expect(request.url.path, '/v1/me/playlists');
+        return request.headers['Authorization'] == 'Bearer new'
+            ? http.Response('{"items":[]}', 200)
+            : http.Response('', 401);
+      }),
+    );
+    addTearDown(library.close);
+    expect((await library.page('id', 'Playlists'))['items'], isEmpty);
+    expect(renewals, [false, true]);
+  });
+
+  test(
+    'a denied library request gives a specific action without another login',
+    () async {
+      var calls = 0;
+      final library = SpotifyLibrary((id, {bool renew = false}) async {
+        calls++;
+        return 'test';
+      }, client: MockClient((_) async => http.Response('', 403)));
+      addTearDown(library.close);
+      await expectLater(
+        library.page('id', 'Spotify albums'),
+        throwsA(
+          isA<StateError>().having((e) => e.message, 'detail', contains('403')),
+        ),
+      );
+      expect(calls, 1);
+    },
+  );
+
+  test('untrusted pagination cannot receive a library token', () async {
+    final library = SpotifyLibrary(
+      (id, {bool renew = false}) async => fail('Requested token'),
+    );
+    addTearDown(library.close);
+    await expectLater(
+      library.page(
+        'id',
+        'Liked Songs',
+        next: 'https://other.example/v1/me/tracks',
+      ),
+      throwsStateError,
+    );
+  });
+}
