+    final ink = night ? const Color(0xffefb26e) : context.appPrimaryTextColor;
+    final paper = night ? const Color(0xff151515) : context.appBackgroundColor;
+    final rows = displayItems;
+    return ColoredBox(
+      color: paper,
+      child: DefaultTextStyle(
+        style: TextStyle(color: ink, fontSize: 15),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
+              child: Text(
+                section,
+                style: const TextStyle(fontWeight: FontWeight.bold),
+              ),
+            ),
+            if (section == 'Now Playing')
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 8),
+                child: Row(
+                  children: [
+                    if (art != null)
+                      FutureBuilder<Uint8List?>(
+                        future: art,
+                        builder: (context, snapshot) {
+                          final bytes = snapshot.data;
+                          return bytes == null
+                              ? const SizedBox.shrink()
+                              : Padding(
+                                  padding: const EdgeInsets.only(right: 8),
+                                  child: Image.memory(
+                                    bytes,
+                                    width: 48,
+                                    height: 48,
+                                    fit: BoxFit.contain,
+                                  ),
+                                );
+                        },
+                      ),
+                    Expanded(
+                      child: Text(
+                        [
+                          track.isEmpty ? 'No track selected' : track,
+                          artist,
+                        ].where((s) => s.isNotEmpty).join('\n'),
+                        maxLines: 3,
+                        overflow: TextOverflow.ellipsis,
+                        style: TextStyle(fontSize: night ? 20 : 17),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            if (busy || message.isNotEmpty)
+              Padding(
+                padding: const EdgeInsets.symmetric(horizontal: 8),
+                child: Text(
+                  busy ? 'Connecting.' : message,
+                  maxLines: 3,
+                  overflow: TextOverflow.ellipsis,
+                ),
+              ),
+            Expanded(
+              child: ListView.builder(
+                controller: scrollController,
+                itemExtent: rowHeight,
+                itemCount: rows.length,
+                itemBuilder: (c, i) => GestureDetector(
+                  behavior: HitTestBehavior.opaque,
+                  onTap: () {
+                    if (!busy) {
+                      setState(() => selectedDisplayItem = i);
