+      message = add ? 'Station saved' : 'Station removed';
+      return;
+    }
+    final pin = entry.id.startsWith('spotify:playlist:');
+    if (!pin && !entry.id.startsWith('spotify:track:')) return;
+    final saved = rewindPins.value.containsKey(entry.id);
+    final action = await showCupertinoModalPopup<String>(
+      context: context,
+      builder: (c) => CupertinoActionSheet(
+        title: Text(entry.title),
+        actions: [
+          CupertinoActionSheetAction(
+            onPressed: () => Navigator.pop(c, 'save'),
+            child: Text(
+              pin
+                  ? (saved ? 'Rename shortcut' : 'Pin to Home')
+                  : 'Add to queue',
